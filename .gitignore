# --- Archive: immutable evidence, never committed ---
# The archive lives outside this repo (see build/config.sh ARCHIVE_DIR).
# This defensive ignore also covers any local copy dropped inside the repo.
archive/
**/archive/

# --- Wordlists (oversized; GitHub 100MB limit) ---
rockyou.txt
rockyou*.txt
*.wordlist
wordlists/full/

# --- Generated VM / disk images & appliances ---
*.ova
*.img
*.ext2
*.ext4
*.qcow2
*.iso
*.vmdk
browser-lab/build/
browser-lab/dist/
vm-appliance/

# --- Build scratch & recovered outputs ---
build/scratch/
build/out/
**/recovered_bundle/
**/rb/
*.tmp

# --- Generated deploy bundle (regenerable via deploy/pages/build.sh) ---
deploy/pages/dist/

# --- Secrets must never be committed to a public deploy ---
# (kept in creator-only build dirs; see per-challenge secret allowlists)
**/creator-only/

# --- OS / editor / language cruft ---
.DS_Store
**/.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/
*.log
